# LLM_PROVIDER picks the model host: gemini (needs GOOGLE_API_KEY) or groq (needs GROQ_API_KEY)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=
# MAX_SOURCES=6
# RESULTS_PER_QUESTION=3
# MAX_REVISIONS=2
# PASS_SCORE=8.0
# MAX_SCRAPE_CHARS=6000
# CORS_ORIGINS=http://localhost:3000
# MAX_TOPIC_CHARS=300
# RATE_LIMIT_PER_MINUTE=5
# MAX_CONCURRENT_RUNS=2
